MLFLOW_TRACKING_URI=https://dagshub.com/<user>/<repo>.mlflow
MLFLOW_TRACKING_USERNAME=<dagshub-username>
MLFLOW_TRACKING_PASSWORD=<dagshub-token>
MLFLOW_EXPERIMENT_NAME=VisionGuard
REGISTERED_MODEL_NAME=VisionGuard

# Web app (Task 4) and Compose database (Task 6). Password: letters and digits only.
MODEL_PATH=models/champion.keras
DATABASE_URL=sqlite:///visionguard.db
SECRET_KEY=change-me
POSTGRES_USER=visionguard
POSTGRES_PASSWORD=<choose-letters-and-digits>
POSTGRES_DB=visionguard
MAX_UPLOAD_MB=5
INFERENCE_MODE=local
# Task 7/8 cloud API
# REMOTE_API_URL=http://<public-ip>:8000
# REMOTE_API_KEY=
# INFERENCE_MODE=remote
